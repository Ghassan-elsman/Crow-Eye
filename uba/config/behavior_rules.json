{
  "version": "2",
  "comment": "Master Behavioral Timeline Correlation Matrix \u2014 declarative rule metadata. Each rule names a Python extractor (uba/engine/extractors/*) that implements the query + correlation; rules added 2026-09-03 cover the artifacts the registry parsers collect but no rule read - scheduled tasks, Defender exclusions, UserChoice handlers, COM in-process servers and the per-user device and document MRUs.",
  "rules": [
    {
      "id": "interactive_logon",
      "matrix_row": 1,
      "behavior_class": "user",
      "activity": "logon",
      "title": "Signed in",
      "extractor": "sessions_logon",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SecurityLogs"
          ]
        },
        "log_eids": {
          "SecurityLogs": [
            4624
          ]
        }
      }
    },
    {
      "id": "logoff",
      "matrix_row": 2,
      "behavior_class": "user",
      "activity": "logoff",
      "title": "Signed out",
      "extractor": "sessions_logoff",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SecurityLogs"
          ]
        },
        "log_eids": {
          "SecurityLogs": [
            4634
          ]
        }
      }
    },
    {
      "id": "workstation_unlock",
      "matrix_row": 3,
