{
  "version": "2",
  "comment": "Master Behavioral Timeline Correlation Matrix \u2014 declarative rule metadata. Each rule names a Python extractor (uba/engine/extractors/*) that implements the query + correlation; rules added 2026-09-03 cover the artifacts the registry parsers collect but no rule read - scheduled tasks, Defender exclusions, UserChoice handlers, COM in-process servers and the per-user device and document MRUs.",
  "rules": [
    {
      "id": "interactive_logon",
      "matrix_row": 1,
      "behavior_class": "user",
      "activity": "logon",
      "title": "Signed in",
      "extractor": "sessions_logon",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SecurityLogs"
          ]
        },
        "log_eids": {
          "SecurityLogs": [
            4624
          ]
        }
      }
    },
    {
      "id": "logoff",
      "matrix_row": 2,
      "behavior_class": "user",
      "activity": "logoff",
      "title": "Signed out",
      "extractor": "sessions_logoff",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SecurityLogs"
          ]
        },
        "log_eids": {
          "SecurityLogs": [
            4634,
            4647
          ]
        },
        "log_eids_mode": "any"
      }
    },
    {
      "id": "workstation_unlock",
      "matrix_row": 3,
      "behavior_class": "user",
      "activity": "unlock",
      "title": "Unlocked the computer",
      "extractor": "sessions_unlock",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SecurityLogs"
          ]
        },
        "log_eids": {
          "SecurityLogs": [
            4624
          ]
        }
      },
      "degrade_note": "Lock/unlock auditing (4800/4801) is not enabled on most systems; unlocks are recovered from logon type 7 events instead."
    },
    {
      "id": "failed_logon",
      "matrix_row": 2,
      "behavior_class": "user",
      "activity": "failed_logon",
      "title": "Failed to sign in",
      "extractor": "failed_logon",
      "severity": "notable",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SecurityLogs"
          ]
        },
        "log_eids": {
          "SecurityLogs": [
            4625
          ]
        }
      },
      "degrade_note": "No failed sign-in records (4625) are present in this case's Security log, so unsuccessful attempts cannot be shown. Absence here is absence of the records, not proof that every sign-in succeeded."
    },
    {
      "id": "winlogon_logon_notification",
      "matrix_row": 1,
      "behavior_class": "user",
      "activity": "logon",
      "title": "Signed in (Windows sign-in record)",
      "extractor": "winlogon_session_notification",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SystemLogs"
          ]
        },
        "log_eids": {
          "SystemLogs": [
            7001
          ]
        },
        "optional_log_eids": {
          "ApplicationLogs": [
            1531,
            1532
          ]
        }
      },
      "how": "Reads Winlogon's own sign-in notification from the System log, which every Windows machine writes with no auditing configured and usually retains far longer than the Security log. Windows does not record the account in these events, so no user is named.",
      "degrade_note": "Windows does not name the account in its sign-in notifications, so these records prove a sign-in happened without identifying who. They are read because the System log normally reaches back further than the Security log."
    },
    {
      "id": "winlogon_logoff_notification",
      "matrix_row": 2,
      "behavior_class": "user",
      "activity": "logoff",
      "title": "Signed out (Windows sign-in record)",
      "extractor": "winlogon_session_notification",
      "severity": "routine",
      "color_token": "class_user",
      "requires": {
        "tables": {
          "logs": [
            "SystemLogs"
          ]
        },
        "log_eids": {
          "SystemLogs": [
            7002
          ]
        },
        "optional_log_eids": {
          "ApplicationLogs": [
            1531,
            1532
          ]
        }
      },
      "how": "Reads Winlogon's own sign-out notification from the System log. As with the sign-in record, Windows does not name the account, so no user is named.",
      "degrade_note": "Windows does not name the account in its sign-out notifications, so these records prove a sign-out happened without identifying who."
    },
