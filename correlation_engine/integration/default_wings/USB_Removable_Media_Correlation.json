{
  "config_name": "usb_removable_media_correlation",
  "wing_name": "USB / Removable Media Correlation (Identity)",
  "wing_id": "default_wing_usb_001",
  "wing_category": "identity",
  "description": "Detects evidence that external storage (USB drives, removable media) was attached and used. Uses a tiered approach with LNK header evidence (Volume Serial Number + drive type = Removable) and ShellBags removable-folder navigation weighted highest, followed by recent-path MRUs and JumpLists, with file-system CREATE/RENAME on removable volumes as supporting context.",
  "proves": "External / removable media was attached and used on the host",
  "author": "Crow-Eye Team",
  "created_date": "2026-05-18T00:00:00Z",
  "last_modified": "2026-11-01T00:00:00Z",
  "version": "1.0",
  "feathers": [
    {
      "feather_config_name": "LNK_CrowEyeFeather",
      "feather_database_path": "feathers/LNK_CrowEyeFeather.db",
      "artifact_type": "LNK",
