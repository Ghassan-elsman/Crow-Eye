      "feather_config_name": "MFT_USN_Correlated_CrowEyeFeather",
      "feather_database_path": "feathers/MFT_USN_Correlated_CrowEyeFeather.db",
      "artifact_type": "MFT",
      "feather_id": "mft_usn",
      "weight": 0.1,
      "tier": 3,
      "tier_name": "File-system CREATE on removable"
    },
    {
      "feather_id": "hid",
      "artifact_type": "HIDDevices",
      "feather_config_name": "HIDDevices_CrowEyeFeather",
