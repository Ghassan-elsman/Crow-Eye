{
  "config_name": "account_logon_correlation",
  "wing_name": "Account Logon & Privilege Use Correlation",
  "wing_id": "default_wing_logon_001",
  "description": "Reconstructs account-level activity on the host: when a session opened (4624), how the account authenticated (4648 / 4776), whether elevated privileges were assigned (4672), and which logon failures preceded it (4625). Uses Security log events as the spine and ties them to the actual artefacts created under the session (UserAssist runs, RecentDocs/MRUs, file activity) so an investigator can attribute behaviour to a specific account.",
  "proves": "An account authenticated to the system and acted under that session",
  "author": "Crow-Eye Team",
  "created_date": "2026-05-18T00:00:00Z",
  "last_modified": "2026-05-18T00:00:00Z",
  "version": "1.0",

  "feathers": [
    {
      "feather_config_name": "SecurityLogs_CrowEyeFeather",
      "feather_database_path": "feathers/SecurityLogs_CrowEyeFeather.db",
      "artifact_type": "SecurityLogs",
      "feather_id": "security_logs",
      "weight": 0.45,
      "tier": 1,
      "tier_name": "Authentication / privilege audit events"
    },
    {
      "feather_config_name": "UserAssist_CrowEyeFeather",
      "feather_database_path": "feathers/UserAssist_CrowEyeFeather.db",
      "artifact_type": "UserAssist",
      "feather_id": "userassist",
      "weight": 0.15,
      "tier": 2,
      "tier_name": "Programs the account launched"
    },
    {
      "feather_config_name": "RecentDocs_CrowEyeFeather",
      "feather_database_path": "feathers/RecentDocs_CrowEyeFeather.db",
      "artifact_type": "RecentDocs",
      "feather_id": "recentdocs",
      "weight": 0.10,
      "tier": 3,
      "tier_name": "Documents opened under the session"
    },
    {
      "feather_config_name": "LastSaveMRU_CrowEyeFeather",
      "feather_database_path": "feathers/LastSaveMRU_CrowEyeFeather.db",
      "artifact_type": "LastSaveMRU",
      "feather_id": "lastsavemru",
      "weight": 0.10,
      "tier": 3,
      "tier_name": "Files saved under the session"
    },
    {
      "feather_config_name": "MFT_USN_Correlated_CrowEyeFeather",
      "feather_database_path": "feathers/MFT_USN_Correlated_CrowEyeFeather.db",
      "artifact_type": "MFT",
      "feather_id": "mft_usn",
      "weight": 0.10,
      "tier": 3,
      "tier_name": "File-system activity under the session"
    },
    {
      "feather_config_name": "SystemLogs_CrowEyeFeather",
      "feather_database_path": "feathers/SystemLogs_CrowEyeFeather.db",
      "artifact_type": "SystemLogs",
      "feather_id": "system_logs",
      "weight": 0.05,
      "tier": 3,
      "tier_name": "Supporting system context"
    },
    {
      "feather_config_name": "ApplicationLogs_CrowEyeFeather",
      "feather_database_path": "feathers/ApplicationLogs_CrowEyeFeather.db",
      "artifact_type": "ApplicationLogs",
      "feather_id": "app_logs",
      "weight": 0.05,
      "tier": 3,
      "tier_name": "Supporting application context"
    }
  ],

  "time_window_minutes": 180,
  "minimum_matches": 1,
  "target_application": "",
  "target_file_path": "",
  "target_event_id": "4624,4625,4634,4647,4648,4672,4776",
  "apply_to": "all",
  "anchor_priority": [
    "SecurityLogs",
    "UserAssist",
    "RecentDocs",
    "LastSaveMRU",
    "MFT",
    "SystemLogs",
    "ApplicationLogs"
  ],
  "use_weighted_scoring": true,

  "scoring": {
    "enabled": true,
    "score_interpretation": {
      "confirmed":  { "min": 0.70, "label": "Confirmed Authenticated Session" },
      "probable":   { "min": 0.40, "label": "Probable Authenticated Session" },
      "weak":       { "min": 0.20, "label": "Weak / Partial Evidence" },
      "not_proven": { "min": 0.00, "label": "Not Proven" }
    }
  },

  "semantic_rules": [
    {
      "rule_id": "auth_successful_logon",
      "name": "Successful Account Logon (4624)",
      "semantic_value": "Account Logon",
      "description": "Security event 4624 — an account successfully authenticated to the host",
      "conditions": [
        { "feather_id": "security_logs", "field_name": "EventID", "operator": "equals", "value": "4624" }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "authentication",
      "severity": "info"
    },
    {
      "rule_id": "auth_special_privileges",
      "technique_id": ["T1078"],
      "tactic": ["privilege-escalation"],
      "name": "Elevated Privileges Assigned (4672)",
      "semantic_value": "Privilege Elevation",
      "description": "Security event 4672 — special privileges (e.g. SeDebugPrivilege, SeTcbPrivilege) assigned to the new logon",
      "conditions": [
        { "feather_id": "security_logs", "field_name": "EventID", "operator": "equals", "value": "4672" }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "privilege_escalation",
      "severity": "high"
    },
    {
      "rule_id": "auth_explicit_creds",
      "name": "Explicit Credential Use (4648)",
      "semantic_value": "Explicit Credentials",
      "description": "Security event 4648 — a process used explicit credentials to authenticate (RunAs, NetUse, scheduled task auth)",
      "conditions": [
        { "feather_id": "security_logs", "field_name": "EventID", "operator": "equals", "value": "4648" }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "authentication",
      "severity": "medium"
    },
    {
      "rule_id": "auth_failure",
      "name": "Failed Logon (4625)",
      "semantic_value": "Authentication Failure",
      "description": "Security event 4625 — a logon attempt failed. Bursts of these preceding a 4624 indicate credential stuffing / brute-force.",
      "conditions": [
        { "feather_id": "security_logs", "field_name": "EventID", "operator": "equals", "value": "4625" }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "authentication",
      "severity": "medium"
    },
    {
      "rule_id": "auth_confirmed_session_activity",
      "name": "Confirmed Session Activity (AND)",
      "semantic_value": "Account Was Active",
      "description": "Successful logon AND at least one user-driven artefact (UserAssist run / RecentDocs / MRU) within the window — proves the account didn't just authenticate, it acted",
      "conditions": [
        { "feather_id": "security_logs", "field_name": "EventID",        "operator": "equals",   "value": "4624" },
        { "feather_id": "userassist",    "field_name": "application_name","operator": "wildcard", "value": "*" }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "authentication",
      "severity": "high"
    },
    {
      "rule_id": "auth_logon_event",
      "name": "Logon Event (Success or Failure)",
      "semantic_value": "Logon Event (4624 or 4625)",
      "description": "Security log shows either a successful (4624) or failed (4625) logon. Previously this rule used AND semantics with conflicting equals values on the same field, which was logically impossible — a single record's EventID can only equal one value, so the AND rule never fired. Now uses OR so each logon event is correctly tagged. Detecting the failed-then-success SEQUENCE (the original intent — possible credential guessing) requires temporal correlation across multiple records in a window, which is outside the per-record AND/OR rule semantics; analysts should look at scored anchors with both event types present rather than relying on a single rule firing.",
      "conditions": [
        { "feather_id": "security_logs", "field_name": "EventID", "operator": "equals", "value": "4625" },
        { "feather_id": "security_logs", "field_name": "EventID", "operator": "equals", "value": "4624" }
      ],
      "logic_operator": "OR",
      "scope": "wing",
      "category": "authentication",
      "severity": "info"
    }
  ],

  "tags": [
    "authentication",
    "logon",
    "privilege",
    "default",
    "weighted"
  ],
  "case_types": [
    "intrusion",
    "insider_threat",
    "compromised_account",
    "audit"
  ]
}
