  "semantic_rules": [
    {
      "rule_id": "ai_cmd",
      "confidence": 0.5,
      "name": "AI agent ran a command",
      "semantic_value": "AI Agent Command",
      "description": "The agent's session record holds a command that started this program.",
      "conditions": [
        {
          "feather_id": "ai_steps",
          "field_name": "kind",
          "operator": "equals",
          "value": "command"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "info"
    },
    {
      "rule_id": "ai_cmd_prefetch",
      "confidence": 0.5,
      "name": "AI command and Prefetch run (AND)",
      "semantic_value": "AI Command Corroborated by Prefetch",
      "description": "The program the agent asked for is in Prefetch: Windows ran it.",
      "conditions": [
        {
          "feather_id": "ai_steps",
          "field_name": "kind",
          "operator": "equals",
          "value": "command"
        },
        {
          "feather_id": "prefetch",
          "field_name": "executable_name",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "info"
    },
    {
      "rule_id": "ai_cmd_4688",
      "confidence": 0.5,
      "name": "AI command and process creation (AND)",
      "semantic_value": "AI Command Corroborated by 4688",
      "description": "A Security 4688 event records the program starting.",
      "conditions": [
        {
          "feather_id": "ai_steps",
          "field_name": "kind",
          "operator": "equals",
          "value": "command"
        },
        {
          "feather_id": "security_logs",
          "field_name": "EventID",
          "operator": "equals",
          "value": "4688"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "info"
    },
    {
      "rule_id": "ai_cmd_failed",
      "confidence": 0.5,
      "name": "AI command that failed",
      "semantic_value": "AI Command Failed",
      "description": "The agent's record gives a non-zero exit code: the program ran and reported failure.",
      "conditions": [
        {
          "feather_id": "ai_steps",
          "field_name": "exit_code",
          "operator": "regex",
          "value": "^-?[1-9][0-9]*$"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "low"
    },
    {
      "rule_id": "ai_runs_shell_script_host",
      "confidence": 0.5,
      "name": "AI agent ran a script host or LOLBin",
      "semantic_value": "AI Agent Ran Script Host",
      "description": "The agent started a script host or a binary often used to fetch or run code (powershell, cmd, wscript, cscript, mshta, rundll32, regsvr32, certutil, bitsadmin, curl, wget).",
      "conditions": [
        {
          "feather_id": "ai_steps",
          "field_name": "executable_name",
          "operator": "regex",
          "value": "(?i)^(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget|msiexec|schtasks|sc|reg|net|netsh|wmic)$"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "medium",
      "technique_id": [
        "T1059"
      ],
      "tactic": [
        "execution"
      ]
    }
  ],
