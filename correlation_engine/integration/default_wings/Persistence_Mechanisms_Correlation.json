  "time_window_minutes": 180,
  "minimum_matches": 1,
  "target_application": "",
  "target_file_path": "",
  "target_event_id": "",
  "apply_to": "all",
  "anchor_priority": [
    "AutoStartPrograms",
    "SystemServices",
    "Prefetch",
    "InventoryApplication",
    "MFT",
    "SystemLogs",
    "ScheduledTasks",
    "ActiveSetup"
  ],
  "use_weighted_scoring": true,
  "scoring": {
    "enabled": true,
    "score_interpretation": {
      "confirmed": {
        "min": 0.7,
        "label": "Confirmed Persistence"
      },
      "probable": {
        "min": 0.4,
        "label": "Probable Persistence"
      },
      "weak": {
        "min": 0.2,
        "label": "Weak / Partial Persistence"
      },
      "not_proven": {
        "min": 0.0,
        "label": "Not Proven"
      }
    }
  },
  "semantic_rules": [
    {
      "rule_id": "pers_run_key",
      "technique_id": [
        "T1547.001"
      ],
      "tactic": [
        "persistence"
      ],
      "name": "Run / RunOnce Autostart Entry",
      "semantic_value": "Run Key Persistence",
      "description": "AutoStartPrograms entry indicates a binary is configured to run at logon/boot. Severity is 'info' because most autostart entries are legitimate (Discord, OneDrive, vendor utilities); tagging every entry as high-severity would drown the analyst in false-positive alerts. The wing's weighted scoring layer escalates the rating when combined with other persistence indicators.",
      "conditions": [
        {
          "feather_id": "autostart",
          "field_name": "command",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "persistence",
      "severity": "info"
    },
    {
      "rule_id": "pers_service_install",
      "technique_id": [
        "T1543.003"
      ],
      "tactic": [
        "persistence"
      ],
      "name": "Service-Based Persistence",
      "semantic_value": "Service Persistence",
      "description": "A service is registered to launch a binary. Severity is 'info' because every Windows install has hundreds of legitimate services; tagging each as high-severity would be a sea of false positives. Suspicious services need additional context (unsigned binary, unusual path, recent install date) to warrant escalation.",
      "conditions": [
        {
          "feather_id": "services",
          "field_name": "image_path",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "persistence",
      "severity": "info"
    },
    {
      "rule_id": "pers_confirmed_runs",
      "name": "Autostart Binary Confirmed to Have Run (AND)",
      "semantic_value": "Persistent Binary Executed",
      "description": "AutoStartPrograms entry AND Prefetch for the same image confirms the persistent binary actually ran. Severity is 'low' because most autostart-listed binaries are expected to run (that's their purpose); the combined evidence is informative but not on its own a critical alert.",
      "conditions": [
        {
          "feather_id": "autostart",
          "field_name": "command",
          "operator": "wildcard",
          "value": "*"
        },
        {
          "feather_id": "prefetch",
          "field_name": "executable_name",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "persistence",
      "severity": "low"
    },
    {
      "rule_id": "pers_service_install_event",
      "name": "Service Install Event Logged",
      "semantic_value": "Service Install (7045/4697)",
      "description": "System or Security log records a service installation",
      "conditions": [
        {
          "feather_id": "system_logs",
          "field_name": "EventID",
          "operator": "equals",
          "value": "7045"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "persistence",
      "severity": "high"
    },
    {
      "rule_id": "pers_inventory_match",
      "name": "Persistent Binary in Software Inventory (OR)",
      "semantic_value": "Inventory Cross-Reference",
      "description": "Amcache InventoryApplication OR InstalledSoftware records the persistent binary",
      "conditions": [
        {
          "feather_id": "amcache_app",
          "field_name": "name",
          "operator": "wildcard",
          "value": "*"
        },
        {
          "feather_id": "installed",
          "field_name": "name",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "OR",
      "scope": "wing",
      "category": "persistence",
      "severity": "info"
    },
    {
      "rule_id": "pers_autostart_disabled",
      "name": "Autostart Entry Is Disabled",
      "semantic_value": "Autostart Entry Is Disabled",
      "scope": "wing",
      "category": "persistence",
      "severity": "info",
      "confidence": 0.95,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "autostart",
          "field_name": "startup_state",
          "operator": "equals",
          "value": "disabled"
        }
      ],
      "tactic": [
        "persistence"
      ],
      "technique_id": [
        "T1547.001"
      ],
      "description": "Windows records this entry as switched off, so it does NOT launch at logon. Without StartupApproved every Run value reads as live persistence: on the reference system six of ten did not run, and two had not since February. Severity is 'info' because a disabled entry is the absence of persistence rather than the presence of it - the point is that the analyst sees the state instead of assuming it."
    },
    {
      "rule_id": "pers_autostart_enabled",
      "name": "Autostart Entry Confirmed Enabled",
      "semantic_value": "Autostart Entry Confirmed Enabled",
      "scope": "wing",
      "category": "persistence",
      "severity": "low",
      "confidence": 0.9,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "autostart",
          "field_name": "startup_state",
          "operator": "equals",
          "value": "enabled"
        }
      ],
      "tactic": [
        "persistence"
      ],
      "technique_id": [
        "T1547.001"
      ],
      "description": "Windows confirms this entry is allowed to launch. Deliberately separate from pers_run_key, which fires on every Run value including the ones that never run. A row whose startup_state is 'unknown' matches neither rule."
    },
    {
      "rule_id": "pers_startup_switched_off",
      "name": "Autostart Approval Withdrawn",
      "semantic_value": "Autostart Approval Withdrawn",
      "scope": "wing",
      "category": "persistence",
      "severity": "info",
      "confidence": 0.95,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "startup_approved",
          "field_name": "state",
          "operator": "equals",
          "value": "disabled"
        }
      ],
      "tactic": [
        "persistence"
      ],
      "technique_id": [
        "T1547.001"
      ],
      "description": "The approval record itself, which carries WHEN the entry was switched off in disabled_at. That is a real event time, so a disabling can be placed on the timeline beside whatever else happened that day."
    },
    {
      "rule_id": "pers_scheduled_task",
      "name": "Scheduled Task Persistence",
      "semantic_value": "Scheduled Task Persistence",
      "scope": "wing",
      "category": "persistence",
      "severity": "info",
      "confidence": 0.8,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "scheduled_tasks",
          "field_name": "task_path",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "tactic": [
        "persistence"
      ],
      "technique_id": [
        "T1053.005"
      ],
      "description": "A registered scheduled task. Severity is 'info' because Windows ships hundreds of legitimate tasks; the wing escalates when the task's binary also shows execution or drop evidence. Until now no feather existed for TaskCache at all, so a top-tier persistence mechanism was invisible to correlation entirely."
    },
    {
      "rule_id": "pers_active_setup",
      "name": "Active Setup Persistence",
      "semantic_value": "Active Setup Persistence",
      "scope": "wing",
      "category": "persistence",
      "severity": "info",
      "confidence": 0.8,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "active_setup",
          "field_name": "name",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "tactic": [
        "persistence"
      ],
      "technique_id": [
        "T1547.014"
      ],
      "description": "Active Setup runs a command once per user at first logon, which makes it a durable per-user persistence location that survives profile creation."
    },
    {
      "rule_id": "pers_safeboot_entry",
      "name": "Safe Mode Persistence",
      "semantic_value": "Safe Mode Persistence",
      "scope": "wing",
      "category": "persistence",
      "severity": "info",
      "confidence": 0.75,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "safeboot",
          "field_name": "entry_name",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "tactic": [
        "persistence",
        "defense-evasion"
      ],
      "technique_id": [
        "T1562.009"
      ],
      "description": "Services and drivers that still start in Safe Mode - the boot an analyst uses to clean a machine, which is exactly why persistence gets placed here. Benign in bulk; the finding is an unexpected name in the list."
    },
    {
      "rule_id": "pers_app_path_entry",
      "name": "App Path Command Resolution",
      "semantic_value": "App Path Command Resolution",
      "scope": "wing",
      "category": "persistence",
      "severity": "info",
      "confidence": 0.7,
      "logic_operator": "AND",
      "conditions": [
        {
          "feather_id": "app_paths",
          "field_name": "executable_path",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "tactic": [
        "persistence",
        "defense-evasion"
      ],
      "technique_id": [
        "T1546"
      ],
      "description": "How a bare command name resolves to an executable. Change the entry and typing the name runs something else, with no path anywhere to give it away."
    }
  ],
  "tags": [
    "persistence",
    "default",
    "weighted",
    "ir"
  ],
  "case_types": [
    "intrusion",
    "malware",
    "apt"
  ]
}
