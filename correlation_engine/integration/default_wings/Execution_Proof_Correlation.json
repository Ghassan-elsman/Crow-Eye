      "severity": "info"
    },
    {
      "rule_id": "exec_confirmed_run",
      "confidence": 0.5,
      "name": "Corroborated Execution (AND)",
      "semantic_value": "Corroborated Program Execution",
      "description": "Prefetch AND ShimCache together corroborate program execution. Severity is 'info' because corroborated execution is the baseline forensic finding the wing was built to surface \u2014 chrome.exe, notepad.exe, calc.exe etc. all match. Tagging this 'high' would drown the analyst in execution noise; the wing's weighted scoring escalates to the 'Strongly Corroborated Execution' label via score thresholds (>=0.70), which is the correct surface for analyst attention.",
      "conditions": [
        {
          "feather_id": "prefetch",
          "field_name": "executable_name",
          "operator": "wildcard",
          "value": "*"
        },
        {
          "feather_id": "shimcache",
          "field_name": "path",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "info"
    },
