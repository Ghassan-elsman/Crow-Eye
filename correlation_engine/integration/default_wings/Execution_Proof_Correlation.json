      "category": "process_execution",
      "severity": "info"
    },
    {
      "rule_id": "exec_user_interaction",
      "confidence": 0.5,
      "name": "User Interaction Evidence (OR)",
      "semantic_value": "User Interaction Detected",
      "description": "LNK OR Jumplist indicates user interacted with application",
      "conditions": [
