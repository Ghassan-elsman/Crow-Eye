  "use_weighted_scoring": true,
  "scoring": {
    "enabled": true,
    "score_interpretation": {
      "confirmed": {
        "min": 0.7,
        "label": "Strongly Corroborated Execution"
      },
      "probable": {
        "min": 0.4,
        "label": "Likely Execution"
      },
      "weak": {
        "min": 0.2,
        "label": "Weak / Partial"
      },
      "not_proven": {
        "min": 0.0,
        "label": "Insufficient Evidence"
      }
    }
  },
  "semantic_rules": [
    {
      "rule_id": "exec_prefetch_run",
      "confidence": 0.5,
      "name": "Program Execution via Prefetch",
      "semantic_value": "Program Executed",
      "description": "Prefetch file indicates program was executed",
      "conditions": [
        {
          "feather_id": "prefetch",
          "field_name": "executable_name",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "info"
    },
    {
      "rule_id": "exec_shimcache_evidence",
      "confidence": 0.5,
      "name": "ShimCache Presence Indicator",
      "semantic_value": "Application Compatibility Evidence",
      "description": "ShimCache entry indicates the file was present/seen by the compatibility layer; not proof of execution on its own",
      "conditions": [
        {
          "feather_id": "shimcache",
          "field_name": "path",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "info"
    },
    {
      "rule_id": "exec_user_launched",
      "confidence": 0.5,
      "technique_id": [
        "T1204"
      ],
      "tactic": [
        "execution"
      ],
      "name": "User-Launched Application (AND)",
      "semantic_value": "User Launched Application",
      "description": "LNK file AND Prefetch together indicate user-initiated execution",
      "conditions": [
        {
          "feather_id": "prefetch",
          "field_name": "executable_name",
          "operator": "wildcard",
          "value": "*"
        },
        {
          "feather_id": "lnk",
          "field_name": "target_path",
          "operator": "wildcard",
          "value": "*"
        }
      ],
      "logic_operator": "AND",
      "scope": "wing",
      "category": "process_execution",
      "severity": "medium"
    },
    {
      "rule_id": "exec_any_evidence",
      "confidence": 0.5,
      "name": "Execution Indicators (OR)",
      "semantic_value": "Execution Indicators Found",
      "description": "Prefetch OR ShimCache OR AmCache provides execution-related indicators",
      "conditions": [
        {
          "feather_id": "prefetch",
          "field_name": "executable_name",
          "operator": "wildcard",
          "value": "*"
        },
